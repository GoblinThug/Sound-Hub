{
  "manifest_version": 3,

  "name": "SoundHub",
  "short_name": "SoundHub",
  "description": "Parametric EQ for any browser tab: presets, spectrum visualizer, color themes, and bilingual UI.",
  "version": "1.3.2",
  "author": "SoundHub",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "64": "assets/icons/icon64.png",
    "128": "assets/icons/icon128.png"
  },

  "action": {
    "default_icon": "assets/icons/icon128.png",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "activeTab",
    "tabCapture",
    "tabs",
    "storage",
    "offscreen",
    "windows",
    "scripting"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/page-eq-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/page-eq.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
